SERVICE_ID=tauron
SERVICE_NAME=Tauron

DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional startup seed symbols for on-chain backfill. Leave empty to disable fixed pre-seed list.
AUTO_POPULATE_ONCHAIN_SYMBOLS=
AUTO_POPULATE_ONCHAIN_METRICS=ALL
AUTO_POPULATE_ONCHAIN_YEARS=5
AUTO_POPULATE_ONCHAIN_TOP_MARKETS=150

ADMIN_API_KEY=
BINANCE_API_KEY=
RATE_LIMIT_MAX_ATTEMPTS=100
RATE_LIMIT_WINDOW_HOURS=1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tauron

POSTGRES_SSL=false
POSTGRES_CONNECT_TIMEOUT=10

POSTGRES_AUTO_CREATE_DATABASE=true
POSTGRES_MAINTENANCE_DATABASE=postgres

DATABASE_URL_OVERRIDE=

DATABASE_SCHEMA=tauron
BOOTSTRAP_DATABASE_ON_STARTUP=true

# Optional override for news scraper tree (default: monorepo ``scrapers/`` or ``/scrapers`` in Docker).
SCRAPERS_DIR=

# Daily scraper -> news_data (requires ``uv`` on PATH; repo layout …/scrapers next to …/backend)
NEWS_SCRAPER_WORKER_ENABLED=false
NEWS_SCRAPER_INTERVAL_SECONDS=86400
NEWS_KNOWLEDGE_SYNC_ENABLED=true
NEWS_CURATION_ENABLED=true
NEWS_CURATION_LOOKBACK_HOURS=24
NEWS_CURATION_MAX_ITEMS=20

# Gemini pipeline (news_data -> knowledge_base embeddings, and curated_news summaries)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
