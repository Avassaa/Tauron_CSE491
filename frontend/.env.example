GEMINI_API_KEY=
# Backend origin for server-side routes (Gemini POST -> FastAPI persistence). Fallback: http://127.0.0.1:8000
# API_INTERNAL_ORIGIN=http://127.0.0.1:8000
# Absolute FastAPI URL for Node actions when not using proxy (optional): http://127.0.0.1:8000/api/v1
# API_INTERNAL_BASE_URL=http://127.0.0.1:8000/api/v1
# Client/API: omit both to use same-origin /api/v1 (recommended in dev; Vite proxies to API_INTERNAL_ORIGIN)
# Or set explicitly: http://localhost:8000/api/v1
# VITE_API_BASE_URL=http://localhost:8000/api/v1
